rules_version = '2';

// TOGG — Throne of God's Grace
// Role model (keep in sync with src/lib/roles.ts):
//   head_pastor (super admin), associate_pastor ... every branch, everything
//   branch_pastor ................................. own branch: members, attendance, tithes/giving, cells, SMS, reviews reports
//   secretary ..................................... own branch: members, attendance, sign-ups, cells, SMS
//   finance ....................................... own branch: tithes/giving (+ read members)
//   usher ......................................... own branch: attendance (+ read members, add first-time visitors)
//   dept_leader (department head) ................. ONLY members of their own departments; monthly report / budget / plan
//   cell_leader ................................... ONLY their own cells: members, reports, new contacts
// The Super Admin can switch areas off per user (users/{uid}.revoked): members, attendance, finance,
// departments, cells, prayer, sms, charity.
//   pending ....................................... nothing until approved
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function activeUser() {
      return signedIn() && exists(userPath(request.auth.uid))
        && me().active == true && me().role != 'pending';
    }
    function isGlobal() { return activeUser() && me().role in ['head_pastor', 'associate_pastor']; }
    function isHead() { return activeUser() && me().role == 'head_pastor'; }
    function roleIn(role, branchId) { return activeUser() && me().role == role && me().branchId == branchId; }
    function hasRole(branchId, roles) {
      return activeUser() && (isGlobal() || (me().branchId == branchId && me().role in roles));
    }
    function myDepts() { return me().get('departmentIds', []); }
    function allowed(area) { return isHead() || !(area in me().get('revoked', [])); }
    function myCells() { return me().get('cellIds', []); }
    function cellData(id) { return get(/databases/$(database)/documents/cells/$(id)).data; }

    function canReadMembers(b)  { return hasRole(b, ['branch_pastor', 'secretary', 'finance', 'usher']) && allowed('members'); }
    function canWriteMembers(b) { return hasRole(b, ['branch_pastor', 'secretary']) && allowed('members'); }
    function canAttendance(b)   { return hasRole(b, ['branch_pastor', 'secretary', 'usher']) && allowed('attendance'); }
    function canGiving(b)       { return hasRole(b, ['branch_pastor', 'finance']) && allowed('finance'); }
    function canSignups(b)      { return hasRole(b, ['branch_pastor', 'secretary']) && allowed('members'); }
    function canCells(b)        { return hasRole(b, ['branch_pastor', 'secretary']) && allowed('cells'); }
    function canSms(b)          { return (isGlobal() || (b is string && hasRole(b, ['branch_pastor', 'secretary']))) && allowed('sms'); }
    // Leading a cell or a department gives access to it whatever the person's main role is (no conflicts).
    function myCell(b, cellId)  { return activeUser() && me().branchId == b && allowed('cells') && cellId in myCells(); }
    function myDeptMember(d)    { return activeUser() && me().branchId == d.branchId && allowed('members') && d.departmentIds.hasAny(myDepts()); }

    function validRole(r) {
      return r in ['head_pastor', 'associate_pastor', 'branch_pastor', 'secretary', 'finance', 'usher', 'dept_leader', 'cell_leader', 'pending'];
    }
    function validAccess(d) {
      return validRole(d.role)
        && (d.role in ['head_pastor', 'associate_pastor', 'pending'] || d.branchId is string)
        && (isHead() || !(d.role in ['head_pastor', 'associate_pastor']));
    }

    // ---------- first-run bootstrap & counters ----------
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.role == 'head_pastor';
      allow update, delete: if false;
    }
    // Membership / tithe card numbers (TOGG-0001…). Can only go up.
    // Written by the SMS server (Apps Script or Cloud Functions) every few minutes.
    match /meta/heartbeat {
      allow read: if activeUser();
    }
    match /meta/counters {
      allow read: if activeUser();
      allow create, update: if activeUser()
        && (me().role in ['head_pastor', 'associate_pastor', 'branch_pastor', 'secretary'] || myDepts().size() > 0)
        && request.resource.data.keys().hasOnly(['memberSeq'])
        && request.resource.data.memberSeq is int
        && request.resource.data.memberSeq > (resource == null ? 0 : resource.data.memberSeq)
        && request.resource.data.memberSeq - (resource == null ? 0 : resource.data.memberSeq) <= 5000;
    }

    // ---------- users & roles ----------
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isGlobal();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'phone', 'role', 'branchId', 'departmentIds', 'active', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.branchId == null
        && request.resource.data.departmentIds == []
        && (
          (request.resource.data.role == 'pending' && request.resource.data.active == false)
          || (request.resource.data.role == 'head_pastor' && request.resource.data.active == true
              && !exists(/databases/$(database)/documents/meta/setup)
              && existsAfter(/databases/$(database)/documents/meta/setup))
        );

      // Super admin / admin creates a staff account directly.
      allow create: if isGlobal() && request.auth.uid != uid && validAccess(request.resource.data)
        && request.resource.data.displayName is string;

      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone']);

      // Recovery: someone who signed up before the database was ready (so their profile is
      // "pending") may still become the first Head Pastor — but only while nobody else has.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'head_pastor' && request.resource.data.active == true
        && request.resource.data.branchId == null
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'phone', 'role', 'branchId', 'departmentIds', 'active', 'createdAt'])
        && !exists(/databases/$(database)/documents/meta/setup)
        && existsAfter(/databases/$(database)/documents/meta/setup);

      allow update: if isGlobal() && request.auth.uid != uid
        && validAccess(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'branchId', 'departmentIds', 'cellIds', 'active', 'revoked'])
        && (isHead() || !(resource.data.role in ['head_pastor', 'associate_pastor']));

      allow delete: if isHead() && request.auth.uid != uid;
    }

    // ---------- church structure ----------
    match /branches/{id} {
      allow read: if true; // shown on the public sign-up forms
      allow write: if isGlobal();
    }

    match /departments/{id} {
      allow read: if true; // names are shown on the public prayer form
      allow write: if isGlobal();
    }

    // ---------- members ----------
    function validMember(d) {
      return d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 80
        && d.branchId is string
        && d.category in ['adult', 'teen', 'child']
        && d.status in ['active', 'inactive', 'visitor']
        && d.departmentIds is list;
    }
    function deptChangeOk(before, after) {
      // a department head may only add/remove their own departments
      return after.toSet().difference(before.toSet()).hasOnly(myDepts().toSet())
        && before.toSet().difference(after.toSet()).hasOnly(myDepts().toSet());
    }
    function cellIsMine(cellId) {
      return cellId is string && allowed('cells') && cellId in myCells();
    }

    match /members/{id} {
      allow read: if canReadMembers(resource.data.branchId)
        || myDeptMember(resource.data)
        || myCell(resource.data.branchId, resource.data.get('cellId', ''));

      allow create: if validMember(request.resource.data) && (
        canWriteMembers(request.resource.data.branchId)
        || (canAttendance(request.resource.data.branchId) && request.resource.data.status == 'visitor')
        || myDeptMember(request.resource.data)
        || (activeUser() && me().branchId == request.resource.data.branchId && request.resource.data.status == 'visitor'
            && cellIsMine(request.resource.data.get('cellId', null)))
      );

      allow update: if validMember(request.resource.data) && (
        (canWriteMembers(resource.data.branchId) && canWriteMembers(request.resource.data.branchId))
        // department head: members of their departments, same branch
        || (myDeptMember(resource.data)
            && request.resource.data.branchId == resource.data.branchId
            && deptChangeOk(resource.data.departmentIds, request.resource.data.departmentIds))
        // cell / department head: put someone in, or take them out of, their cell
        || (activeUser() && me().branchId == resource.data.branchId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cellId', 'updatedAt'])
            && (cellIsMine(request.resource.data.cellId)
                || (request.resource.data.cellId == null && cellIsMine(resource.data.get('cellId', null)))))
      );

      allow delete: if canWriteMembers(resource.data.branchId);
    }

    // ---------- attendance ----------
    match /services/{sid} {
      allow read: if canAttendance(resource.data.branchId);
      allow create: if canAttendance(request.resource.data.branchId)
        && request.resource.data.count == 0 && request.resource.data.visitors == 0
        && request.resource.data.date is string;
      allow update: if canAttendance(resource.data.branchId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'visitors', 'title', 'type', 'date'])
        && request.resource.data.visitors >= 0;
      allow delete: if canWriteMembers(resource.data.branchId);
      allow create, update: if isGlobal(); // restore from backup

      match /checkins/{mid} {
        function svcBranch() { return get(/databases/$(database)/documents/services/$(sid)).data.branchId; }
        allow read: if canAttendance(svcBranch());
        allow create: if canAttendance(svcBranch()) && request.resource.data.memberId == mid;
        allow delete: if canAttendance(svcBranch());
        allow update: if isGlobal();
      }
    }

    // ---------- tithes & giving ----------
    match /giving/{id} {
      allow read: if canGiving(resource.data.branchId);
      allow create, update: if canGiving(request.resource.data.branchId)
        && (request.method == 'create' || canGiving(resource.data.branchId))
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.type is string;
      allow delete: if canGiving(resource.data.branchId);
    }

    // ---------- service collections (money counted at each service) ----------
    match /collections/{id} {
      allow read: if canGiving(resource.data.branchId);
      allow create: if canGiving(request.resource.data.branchId) && request.resource.data.date is string && request.resource.data.lines is map;
      allow update: if canGiving(resource.data.branchId) && canGiving(request.resource.data.branchId);
      allow delete: if canGiving(resource.data.branchId);
    }

    // ---------- cells ----------
    // Cells stand on their own (not under a department). Names are public for the prayer form.
    match /cells/{id} {
      allow read: if true;
      allow create: if canCells(request.resource.data.branchId) && request.resource.data.name is string;
      allow update: if canCells(resource.data.branchId) && canCells(request.resource.data.branchId);
      allow delete: if canCells(resource.data.branchId);
    }

    // Cell leaders' log book, one per cell per month. id = {cellId}_{YYYY-MM}
    match /cellLogs/{id} {
      function cellOf() { return id.split('_')[0]; }
      function branchOf() { return cellData(cellOf()).branchId; }
      function okLog(d) { return d.cellId == cellOf() && d.month == id.split('_')[1] && d.branchId == branchOf() && d.rows is list && d.meetings is list; }
      allow get: if canCells(branchOf()) || myCell(branchOf(), cellOf());
      allow list: if canCells(resource.data.branchId) || myCell(resource.data.branchId, resource.data.cellId);
      allow create, update: if (canCells(branchOf()) || myCell(branchOf(), cellOf())) && okLog(request.resource.data);
      allow delete: if canCells(branchOf());
    }

    match /cellReports/{id} {
      function canReport(d) {
        return d.cellId is string
          && cellData(d.cellId).branchId == d.branchId
          && (canCells(d.branchId) || myCell(d.branchId, d.cellId));
      }
      allow read: if canCells(resource.data.branchId) || myCell(resource.data.branchId, resource.data.cellId);
      allow create: if canReport(request.resource.data);
      allow update: if canReport(resource.data) && canReport(request.resource.data);
      allow delete: if canCells(resource.data.branchId);
      allow create, update: if isGlobal();
    }

    // ---------- department reports, budgets & plans ----------
    // id = {departmentId}_{branchId}_{YYYY-MM}_{report|budget|plan}
    match /deptReports/{id} {
      function part(i) { return id.split('_')[i]; }
      function isAuthor() {
        return activeUser() && allowed('departments') && (isGlobal() || (me().branchId == part(1) && part(0) in myDepts()));
      }
      function isReviewer() { return allowed('departments') && (isGlobal() || roleIn('branch_pastor', part(1))); }
      function matchesId(d) {
        return d.departmentId == part(0) && d.branchId == part(1) && d.month == part(2) && d.type == part(3)
          && d.type in ['report', 'budget', 'plan'];
      }
      allow get: if isAuthor() || isReviewer();
      allow list: if allowed('departments') && (isGlobal() || roleIn('branch_pastor', resource.data.branchId));
      allow create: if isAuthor() && matchesId(request.resource.data) && request.resource.data.status in ['draft', 'submitted'];
      allow update: if isAuthor() && matchesId(request.resource.data)
        && request.resource.data.status in ['draft', 'submitted']
        && (isGlobal() || resource.data.status != 'approved');
      allow update: if isReviewer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewComment', 'reviewedByName', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'returned'];
      allow delete: if isGlobal();
      allow create, update: if isGlobal() && matchesId(request.resource.data);
    }

    // ---------- SMS ----------
    match /smsMessages/{id} {
      allow read: if canSms(resource.data.branchId);
      allow create: if canSms(request.resource.data.branchId)
        && request.resource.data.status in ['queued', 'scheduled']
        && request.resource.data.kind in ['instant', 'scheduled']
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 918
        && (isGlobal() || request.resource.data.audience.branchId == request.resource.data.branchId);
      allow update: if canSms(resource.data.branchId) && resource.data.status == 'scheduled'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isGlobal();
    }

    match /programmes/{id} {
      function okProgramme(d) {
        return canSms(d.branchId) && (isGlobal() || d.audience.branchId == d.branchId)
          && d.title is string && d.days is list && d.time is string;
      }
      allow read: if canSms(resource.data.branchId);
      allow create: if okProgramme(request.resource.data);
      allow update: if canSms(resource.data.branchId) && okProgramme(request.resource.data);
      allow delete: if canSms(resource.data.branchId);
    }

    match /settings/{id} {
      allow read: if activeUser();
      allow write: if isGlobal();
    }
    // MoMo number, payment link, bank details: shown on the public giving / project / charity pages.
    match /settings/payments {
      allow read: if true;
      allow write: if isGlobal();
    }
    // Where voice notes / videos are uploaded (the public prayer form needs to know).
    match /settings/media {
      allow read: if true;
      allow write: if isGlobal();
    }

    // ---------- personal reminders (everyone, only their own) ----------
    match /reminders/{id} {
      allow read, update, delete: if activeUser() && resource.data.ownerUid == request.auth.uid
        && (request.method != 'update' || request.resource.data.ownerUid == request.auth.uid);
      allow create: if activeUser() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.remindAt is string;
    }

    // ---------- Head Pastor's private assessments and reminders ----------
    match /pastorNotes/{id} {
      allow read, write: if isHead();
    }

    // ---------- church projects (fund-raising + progress) ----------
    match /projects/{id} {
      allow read: if resource.data.public == true || activeUser();
      allow create, delete: if isGlobal() && allowed('finance');
      allow update: if isGlobal() && allowed('finance');
      // whoever records a contribution keeps the total up to date
      allow update: if activeUser() && me().role in ['branch_pastor', 'finance'] && allowed('finance')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['raised', 'donors']);
    }

    // ---------- Charity Foundation ----------
    function canCharity() {
      return activeUser() && allowed('charity') && (isGlobal()
        || (myDepts().size() > 0
            && exists(/databases/$(database)/documents/settings/charity)
            && get(/databases/$(database)/documents/settings/charity).data.departmentId in myDepts()));
    }
    match /charity/{id} {
      allow read, write: if canCharity();
    }

    // ---------- prayer requests & testimonies ----------
    // Sent up the hierarchy; leaders above the chosen person can also see it,
    // except requests for the Head Pastor, which stay private to him.
    function canSeePrayer(d) {
      return (d.toLevel == 'head_pastor' && isHead())
        || (d.toLevel == 'associate_pastor' && isGlobal() && allowed('prayer'))
        || (d.toLevel in ['branch_pastor', 'dept_leader', 'cell_leader'] && allowed('prayer')
            && (isGlobal() || roleIn('branch_pastor', d.branchId)))
        || (d.toLevel in ['dept_leader', 'cell_leader'] && roleIn('secretary', d.branchId) && allowed('prayer'))
        || (d.toLevel == 'dept_leader' && activeUser() && me().branchId == d.branchId && allowed('prayer') && d.departmentId in myDepts())
        || (d.toLevel == 'cell_leader' && activeUser() && me().branchId == d.branchId && allowed('prayer') && d.cellId in myCells());
    }
    match /prayerRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'name', 'phone', 'phoneKey', 'branchId', 'toLevel', 'departmentId', 'cellId', 'text', 'mediaPath', 'mediaUrl', 'mediaType', 'confidential', 'status', 'answerNote', 'memberId', 'createdAt'])
        && (!('mediaUrl' in request.resource.data) || request.resource.data.mediaUrl == ''
            || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() < 400
                && request.resource.data.mediaUrl.matches('https://res[.]cloudinary[.]com/.*')))
        && request.resource.data.kind in ['prayer', 'testimony']
        && request.resource.data.toLevel in ['cell_leader', 'dept_leader', 'branch_pastor', 'associate_pastor', 'head_pastor']
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.text is string && request.resource.data.text.size() <= 4000
        && request.resource.data.mediaPath is string && request.resource.data.mediaPath.size() <= 200
        && (request.resource.data.mediaPath == '' || request.resource.data.mediaPath.matches('prayer/' + id + '/.*'))
        && request.resource.data.mediaType in ['', 'audio', 'video']
        && request.resource.data.status == 'new' && request.resource.data.memberId == '' && request.resource.data.answerNote == ''
        && request.resource.data.branchId is string
        && exists(/databases/$(database)/documents/branches/$(request.resource.data.branchId))
        && request.resource.data.createdAt == request.time;
      allow read: if canSeePrayer(resource.data);
      allow update: if canSeePrayer(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answerNote', 'memberId', 'updatedAt'])
        && request.resource.data.status in ['new', 'praying', 'answered'];
      allow delete: if isGlobal();
    }

    // SMS API key: admins can set it, nobody can read it back (only the server).
    match /secrets/{id} {
      allow read: if false;
      allow write: if isGlobal();
    }

    // ---------- public sign-up forms ----------
    match /registrations/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'firstName', 'lastName', 'phone', 'email', 'gender', 'category', 'branchId', 'invitedBy', 'prayerRequest', 'status', 'createdAt'])
        && request.resource.data.kind in ['member', 'visitor']
        && request.resource.data.status == 'new'
        && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 60
        && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.invitedBy is string && request.resource.data.invitedBy.size() <= 120
        && request.resource.data.prayerRequest is string && request.resource.data.prayerRequest.size() <= 2000
        && request.resource.data.category in ['adult', 'teen', 'child']
        && request.resource.data.branchId is string
        && exists(/databases/$(database)/documents/branches/$(request.resource.data.branchId))
        && request.resource.data.createdAt == request.time;
      allow read, delete: if canSignups(resource.data.branchId);
      allow update: if canSignups(resource.data.branchId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'processedAt']);
      allow create, update: if isGlobal() && request.resource.data.status in ['new', 'done'];
    }

    // ---------- data from the old 2025 attendance form ----------
    // Kept readable for the Head / Associate Pastor so nothing is lost. The old form itself
    // can no longer write once these rules are deployed.
    match /attendance/{id} {
      allow read: if isGlobal();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
