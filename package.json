{
  "name": "togg-church-management",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage --project demo-togg",
    "test:rules": "firebase emulators:exec --only firestore --project demo-togg \"node tests/rules.test.mjs\"",
    "deploy": "npm run build && firebase deploy",
    "test:sms": "npm --prefix functions run build && firebase emulators:exec --only firestore --project demo-togg-fn \"node functions/test/core.test.mjs\"",
    "deploy:web": "npm run build && firebase deploy --only hosting,firestore",
    "test:storage": "firebase emulators:exec --only firestore,storage --project demo-togg \"node tests/storage.test.mjs\"",
    "test:sms-server": "firebase emulators:exec --only firestore --project demo-sms \"node sms-server/test/apps-script.test.cjs\""
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "lucide-react": "^0.460.0",
    "papaparse": "^5.4.1",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^13.29.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
